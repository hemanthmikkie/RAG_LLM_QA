# API Keys (Provide at least one LLM/Embedding provider key or use free local embeddings)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Default Application Settings
DEFAULT_EMBEDDING_PROVIDER=huggingface  # Options: huggingface, gemini, openai
DEFAULT_LLM_PROVIDER=gemini             # Options: gemini, openai, groq, mock
DEFAULT_CHUNK_SIZE=600
DEFAULT_CHUNK_OVERLAP=80
DEFAULT_TOP_K=4
RETRIEVER_TYPE=hybrid                   # Options: hybrid, dense

